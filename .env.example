# Professional Portfolio - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=portfolio_db

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=5000

# =============================================================================
# SESSION SECURITY
# =============================================================================
# Generate a strong random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production

# =============================================================================
# AUTHENTICATION (Optional - for Replit Auth integration)
# =============================================================================
# If you want to use Replit authentication, uncomment and configure:
# REPLIT_DOMAINS=yourdomain.com,www.yourdomain.com
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types for uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to true to enable detailed error logging
DEBUG_MODE=true

# Frontend development server (if running separately)
VITE_API_URL=http://localhost:5000